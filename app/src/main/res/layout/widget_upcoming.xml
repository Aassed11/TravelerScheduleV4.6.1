<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/upcoming_header"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="TRAVELER · 다가오는 일정"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#151515" />
        <ImageButton
            android:id="@+id/upcoming_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="새로고침"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/upcoming_row_1"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/upcoming_title_1"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#151515"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_subtitle_1"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:textSize="10sp"
            android:textColor="#667085"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/upcoming_row_2"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/upcoming_title_2"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#151515"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_subtitle_2"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:textSize="10sp"
            android:textColor="#667085"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/upcoming_row_3"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/upcoming_title_3"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#151515"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_subtitle_3"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:textSize="10sp"
            android:textColor="#667085"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/upcoming_row_4"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/upcoming_title_4"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#151515"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_subtitle_4"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:textSize="10sp"
            android:textColor="#667085"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/upcoming_row_5"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/upcoming_title_5"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#151515"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/upcoming_subtitle_5"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:textSize="10sp"
            android:textColor="#667085"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
    <TextView
        android:id="@+id/upcoming_empty"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="다가오는 일정이 없습니다."
        android:textSize="12sp"
        android:textColor="#667085"
        android:visibility="gone" />
</LinearLayout>
